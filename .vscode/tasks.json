{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "quartus_cmd",
            "args": [
                "FinalProject",
                "-c",
                "FinalProject",
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Test",
            "type": "shell",
            "command": "quartus_pgm",
            "args": [
                "-c",
                "USB-Blaster",
                "output_files/FinalProject.cdf",
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": false
            }
        },
        {
            "label": "Build & Test",
            "type": "shell",
            "command": "quartus_pgm",
            "args": [
                "-c",
                "USB-Blaster",
                "output_files/FinalProject.cdf",
            ],
            "runOptions": {
                "instanceLimit": 1
            },
            "problemMatcher": [],
            "dependsOn": [
                "Build"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
    ],
    "options": {
        "cwd": "${workspaceFolder}",
    },
}